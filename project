# The project buildsys/ builds (BUILD.md): "key value" lines.
# name: names the project's settings (pos-sdk.conf), tools images and
# containers, and recipes archive.
name pos-sdk
# pipeline: the pipeline of the project's packages and builds, the
# toolchain's (the engine's BUILD.md "Toolchain").
pipeline toolchain
# prefix: where the packages install; <version> is <product
# version>.<revision> of VERSION. The sdk is the whole prefix; gcc-runtime
# installs in /pos (its meta).
prefix /apps/pos-sdk/<version>
# pos-reference: the pos reference toolchain builds build on, a build ID
# or pos/<release>. Its glibc is the oldest the sdk runs on: move it only
# to raise that, or to a reference of the same glibc (the engine's
# BUILD.md "Reference builds").
pos-reference 202610311413
# engine: the pos commit whose buildsys/ ./build runs.
engine a82797e84ed00823026fc7081038ec4aea39f13f
